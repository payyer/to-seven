# Sao chép thành .env.local rồi điền giá trị. Không commit file .env.local.

# Bắt buộc để AI chữa câu (lấy tại https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Tuỳ chọn: model và mức effort (mặc định claude-opus-5-5, low)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Bắt buộc: nhập một lần trên mỗi trình duyệt để mở khóa dữ liệu và tính năng AI
APP_ACCESS_CODE=

# Cloud progress (server-only; never use NEXT_PUBLIC_ for secret values)
SUPABASE_URL=https://apzwvsffbyccwrmdwezq.supabase.co
SUPABASE_SECRET_KEY=
# Random secret, at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=

# Preview deployments are blocked by default. Only set to 1 with a separate preview Supabase project.
# ALLOW_PREVIEW_DATABASE=1

# Chỉ dùng khi phát triển: chấm câu giả, không gọi API
# AI_MOCK=1
