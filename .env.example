# Sao chép thành .env.local rồi điền giá trị. Không commit file .env.local.

# Bắt buộc để AI chữa câu (lấy tại https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Tuỳ chọn: model và mức effort (mặc định claude-opus-5-5, low)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Nên đặt khi deploy công khai: người dùng phải nhập mã này trong Cài đặt mới gọi được AI
# APP_ACCESS_CODE=

# Chỉ dùng khi phát triển: chấm câu giả, không gọi API
# AI_MOCK=1
